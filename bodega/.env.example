HOST=127.0.0.1
PORT=8787
BODEGA_PUBLIC_URL=http://127.0.0.1:8787
BODEGA_WALLET_ID=local-demo
BODEGA_CAP_CENTS=1000
BODEGA_THRESHOLD_CENTS=100
# mock | stripe-cli (local sandbox CLI) | stripe (server-side test SDK key)
BODEGA_PAYMENTS=mock
BODEGA_PAYMENT_FLOW=direct
# simulated never executes code; blaxel uses the configured cloud workspace
BODEGA_RUNTIME=simulated
# Set separate random values of at least 24 characters.
BODEGA_AGENT_TOKEN=
BODEGA_VENDOR_ADMIN_TOKEN=
BODEGA_HUMAN_EMAIL=
# Required for SDK payments/webhook reconciliation; live keys are refused.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional MPP adapter: requires SDK test key, profile/network ID, 32-byte secret and buyer SPT preview access.
STRIPE_PROFILE_ID=
MPP_SECRET_KEY=
BODEGA_BUYER_SPT_CONFIGURED=0
BL_API_KEY=
BL_WORKSPACE=
BL_REGION=us-pdx-1
# A cloud sandbox needs an HTTPS public proxy URL reachable from Blaxel.
PRIMITIVE_API_KEY=
PRIMITIVE_TRIAL_INBOX=
INKBOX_API_KEY=
# Server-only InsForge admin credentials; never prefix with PUBLIC or VITE.
INSFORGE_URL=
INSFORGE_API_KEY=
