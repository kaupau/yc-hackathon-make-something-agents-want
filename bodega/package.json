{
  "name": "bodega",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Bodega: agents find, trial, compare and buy dev tools",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "demo:mock": "tsx src/mocks/demo.ts",
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc",
    "test": "tsx --test src/**/*.test.ts",
    "approvals": "node --env-file-if-exists=.env --import tsx scripts/approvals.ts",
    "customers": "node --env-file-if-exists=.env --import tsx scripts/customers.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@blaxel/core": "^0.3.30",
    "@insforge/sdk": "^1.5.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "mppx": "^0.13.5",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "js-yaml": "^5.5.0"
  }
}
